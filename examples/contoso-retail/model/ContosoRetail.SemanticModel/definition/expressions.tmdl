/// Folder holding the Contoso Retail parquet files (generated by contoso-universe-gen).
/// A real M PARAMETER (not a plain query) so the partitions stay firewall-safe.
/// Change this one value to point the model at your own regenerated copy.
expression DataFolder = "E:/MIS-REPO/fabric-data-agents/examples/contoso-retail/data/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b0000000-0000-0000-0000-0000000000d0
	annotation PBI_ResultType = Text
